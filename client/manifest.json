{
  "manifest_version": 3,
  "name": "SemanticEdge",
  "version": "1.0.0",
  "description": "Agente perimetral inteligente contra phishing avanzado.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SemanticEdge Status",
    "default_popup": "../assets/demo/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}