{
  "manifest_version": 3,
  "name": "SemanticEdge",
  "version": "1.0.0",
  "description": "Agente perimetral inteligente contra phishing avanzado.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SemanticEdge Status",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {                     
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}